# ============================================
# FRONTEND ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================
# API CONFIGURATION
# ============================================
# Backend API URL
# In development, Vite proxy handles /api requests to localhost:5000
# In production, set this to your actual API URL

# Development (using Vite proxy - no need to set)
# VITE_API_URL=/api

# Production example:
# VITE_API_URL=https://api.yourdomain.com/api

# ============================================
# OPTIONAL: ANALYTICS
# ============================================
# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# ============================================
# OPTIONAL: FEATURE FLAGS
# ============================================
# Enable/disable features
# VITE_ENABLE_TESTIMONIALS=true
# VITE_ENABLE_BOOKINGS=true
# VITE_MAINTENANCE_MODE=false

# ============================================
# NOTES
# ============================================
# 1. Vite exposes env variables that start with VITE_ to the client
# 2. Never store sensitive data (API keys, secrets) in frontend .env
# 3. Frontend .env is bundled into the client code (publicly accessible)
# 4. Use backend environment variables for sensitive configuration
# 5. In development, Vite proxy handles API requests automatically
